# Environment
ENV=development
DEBUG=true

# URLs (API publique pour le worker et l'iPhone, dashboard pour les liens des notifications)
API_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:3000

# CORS : dashboard Nuxt en dev (3000) et fenêtre Tauri (tauri://localhost, http://tauri.localhost)
CORS_ORIGINS=http://localhost:3000,tauri://localhost,http://tauri.localhost

# Database (SQLite, fichier dans data/ ; dans Docker : sqlite:////app/data/la-bonne-truffe.db)
DATABASE_URL=sqlite:///./data/la-bonne-truffe.db

# JWT
SECRET_KEY=dev-secret-key-change-in-production
ALGORITHM=HS256
# Durée de vie du jeton en minutes. 43200 = 30 jours (un seul utilisateur, pas de refresh token).
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Le compte de départ (créé par le seeder)
ADMIN_NAME=Léo
ADMIN_EMAIL=contact@dibodev.fr
ADMIN_PASSWORD=change-me

# Inscription (écran « Créer un compte »)
SIGNUP_ENABLED=true

# E-mails du compte (Resend) — sans clé, le lien de « Mot de passe oublié » est écrit dans les logs de l'API
RESEND_API_KEY=
EMAIL_FROM=La Bonne Truffe <contact@dibodev.fr>
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# Web Push (VAPID) — générer la paire avec : python cli.py vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY_B64=
VAPID_SUBJECT=mailto:contact@dibodev.fr

# Collecte : adresse mise dans le User-Agent honnête des sources HTML
# (LaBonneTruffe/1.0 (+mailto:<adresse>)). La Centrale Canine reçoit un User-Agent de navigateur.
COLLECT_USER_AGENT_CONTACT=contact@dibodev.fr
# Sources que ce poste ne relève pas, séparées par des virgules (centrale_canine, chiens_de_france, chiots_de_france)
COLLECT_SKIPPED_SOURCES=
