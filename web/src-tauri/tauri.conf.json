{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "La Bonne Truffe",
  "version": "0.1.0",
  "identifier": "fr.dibodev.labonnetruffe",
  "build": {
    "beforeDevCommand": "cross-env NUXT_DESKTOP_BUILD=1 nuxt dev --port 1420",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run desktop:generate",
    "frontendDist": "../.output/public"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "La Bonne Truffe",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "visible": false,
        "resizable": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/Leoglme/la-bonne-truffe/releases/latest/download/latest.json"],
      "pubkey": "__TAURI_UPDATER_PUBKEY__"
    }
  }
}
